{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion-multiversal.pages.dev/schemas/roster-data.schema.json",
  "title": "Legión Multiversal — Roster data",
  "type": "object",
  "required": [
    "schema_version",
    "identity_model_version",
    "heroes",
    "name_registry"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "identity_model_version": {
      "const": 1
    },
    "heroes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "display_name",
          "identity_scope",
          "role",
          "creator_type",
          "accounts",
          "schedule",
          "links"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "identity_scope": {
            "enum": [
              "shared_project",
              "individual_creator"
            ]
          },
          "represented_people": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "platform",
                "account_type",
                "handle",
                "url",
                "ownership",
                "status",
                "collection",
                "public_metrics",
                "restricted_metrics"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "twitch",
                    "youtube",
                    "instagram",
                    "kick"
                  ]
                },
                "account_type": {
                  "enum": [
                    "creator_channel",
                    "social_profile"
                  ]
                },
                "handle": {
                  "type": "string"
                },
                "login": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "ownership": {
                  "enum": [
                    "shared",
                    "individual"
                  ]
                },
                "status": {
                  "enum": [
                    "registered",
                    "confirmed",
                    "needs_review"
                  ]
                },
                "collection": {
                  "type": "object",
                  "required": [
                    "mode",
                    "source",
                    "output_file"
                  ],
                  "properties": {
                    "mode": {
                      "enum": [
                        "public_app_token",
                        "public_api_key",
                        "public_client_credentials",
                        "manual_link_only"
                      ]
                    },
                    "collector": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "source": {
                      "type": "string"
                    },
                    "output_file": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "public_metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "restricted_metrics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "string"
                }
              }
            }
          },
          "links": {
            "type": "array",
            "description": "Enlaces complementarios y agregadores de perfiles (por ejemplo, Beacons); las redes sociales directas se registran en socials/accounts.",
            "items": {
              "type": "object",
              "required": [
                "platform",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "platform": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "tagline": {
            "type": "string",
            "maxLength": 160,
            "description": "Frase editorial breve para la tarjeta principal."
          },
          "powers": {
            "type": "string",
            "minLength": 1,
            "description": "Descripción pública de especialidades narrativas o creativas."
          },
          "socials": {
            "type": "object",
            "description": "Perfiles sociales confirmados y directos. Beacons u otros hubs agregadores se registran en links, no aquí.",
            "properties": {
              "twitch": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www[.])?twitch[.]tv/"
              },
              "youtube": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://((www[.])?youtube[.]com|youtu[.]be)/"
              },
              "instagram": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www[.])?instagram[.]com/"
              },
              "tiktok": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www[.])?tiktok[.]com/"
              },
              "facebook": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(www[.])?facebook[.]com/"
              }
            },
            "additionalProperties": false
          },
          "bitacora": {
            "type": "array",
            "description": "Línea de tiempo pública del perfil. Solo hechos confirmados por el creador o por una fuente citada.",
            "items": {
              "type": "object",
              "required": [
                "type",
                "title",
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "origen",
                    "canal",
                    "expediente",
                    "proximo"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          },
          "schedule": {
            "type": "string",
            "minLength": 1,
            "description": "Horario declarado por el creador. Es una referencia editorial; no representa actividad medida ni compromiso de disponibilidad."
          }
        }
      }
    },
    "name_registry": {
      "type": "object",
      "description": "Registro canónico de nombre visible, usuario de plataforma, alias de personaje y variantes históricas.",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": [
          "display_name",
          "platform",
          "username",
          "character_alias",
          "variants",
          "short_description"
        ],
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "enum": [
              "twitch",
              "youtube",
              "instagram",
              "kick"
            ]
          },
          "username": {
            "type": "string",
            "minLength": 1
          },
          "character_alias": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "represented_people": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "display_name",
                "variants"
              ],
              "properties": {
                "display_name": {
                  "type": "string"
                },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "short_description": {
            "type": "string",
            "minLength": 12
          }
        }
      }
    }
  }
}
