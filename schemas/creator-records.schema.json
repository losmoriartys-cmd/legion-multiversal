{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion-multiversal.pages.dev/schemas/creator-records.schema.json",
  "title": "Legión Multiversal — Expedientes editoriales por creador",
  "type": "object",
  "required": [
    "schema_version",
    "description",
    "channels"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/channel"
      }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "editorialItem": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "collaboration": {
      "type": "object",
      "required": [
        "title",
        "description",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/httpsUrl"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "highlight": {
      "type": "object",
      "required": [
        "title",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/httpsUrl"
            }
          ]
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "clip_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "required": [
        "key",
        "label",
        "value",
        "unit"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "case_id",
        "title",
        "date",
        "format",
        "participants",
        "source",
        "verification_status",
        "channel_scope",
        "metrics",
        "note"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "verification_status": {
          "enum": [
            "creator_reported",
            "public_source",
            "platform_verified"
          ]
        },
        "channel_scope": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "youtubeVideo": {
      "type": "object",
      "required": [
        "title",
        "views",
        "age",
        "source"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "views": {
          "type": [
            "integer",
            "number",
            "string",
            "null"
          ]
        },
        "age": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "embed": {
      "type": "object",
      "required": [
        "video_id",
        "title",
        "source"
      ],
      "properties": {
        "video_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{6,20}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "profileNotes": {
      "type": "object",
      "required": [
        "role",
        "content_focus",
        "future_direction",
        "schedule",
        "metrics_source"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "content_focus": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "future_direction": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "metrics_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "channel": {
      "type": "object",
      "required": [
        "milestones",
        "collaborations",
        "highlights"
      ],
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/editorialItem"
          }
        },
        "collaborations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collaboration"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "collaboration_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result"
          }
        },
        "youtube_videos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/youtubeVideo"
          }
        },
        "featured_embeds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/embed"
          }
        },
        "profile_notes": {
          "$ref": "#/$defs/profileNotes"
        },
        "audience_report": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
