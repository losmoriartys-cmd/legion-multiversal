{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://legion-multiversal.pages.dev/schemas/community-playbook.schema.json",
  "title": "Legión Multiversal — Misiones y logros de Comunidad",
  "type": "object",
  "required": [
    "schema_version",
    "missions",
    "achievements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "missions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mission"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/achievement"
      }
    }
  },
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "const": "roster_total"
        }
      ]
    },
    "mission": {
      "type": "object",
      "required": [
        "id",
        "category",
        "title",
        "description",
        "progress_key",
        "target",
        "progress_label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "progress_key": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "progress_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "achievement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "progress_key",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "progress_key": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "additionalProperties": false
    }
  }
}
